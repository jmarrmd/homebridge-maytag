  "types": "dist/index.d.ts",
  "files": [
    "config.schema.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "watch": "tsc -w"
  },
  "keywords": [
    "homebridge-plugin",
    "whirlpool",
    "maytag",
    "washer",
    "dryer",
    "laundry"
  ],
  "author": "Josh",
  "license": "ISC",
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22 || ^24"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "homebridge": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "homebridge": {
    "alias": "WhirlpoolCloud",
    "type": "platform"
  },
  "homepage": "https://github.com/jmarrmd/homebridge-maytag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmarrmd/homebridge-maytag.git"
  },
